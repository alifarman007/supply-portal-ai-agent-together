# Copy to .env.local and fill in. Never put a real secret in this file.

# The bill checking agent (the Python service in ../agent).
# SERVER-ONLY on purpose: no NEXT_PUBLIC_ prefix, because the agent has no
# authentication and no CORS, so the browser must never call it directly.
# Start the agent with:  cd agent && python -m uv run python -m app.cli serve
BILLCHECK_BASE_URL=http://127.0.0.1:8000

# The internal Bill Checking section (/app/billcheck).
# BILLCHECK_INTERNAL is the REAL gate: the /api/billcheck/queue and
# /api/billcheck/bill/* handlers return 404 unless it is exactly "true". Leave it
# unset anywhere the portal is publicly reachable - those screens list other
# suppliers' bills and the portal has no real authentication yet.
# NEXT_PUBLIC_BILLCHECK_INTERNAL only shows the sidebar link. It is cosmetic; hiding
# a signpost is not access control.
BILLCHECK_INTERNAL=false
NEXT_PUBLIC_BILLCHECK_INTERNAL=false

# iDempiere ERP. Leave blank and the portal falls back to its mock purchase orders.
# The base URL ends at the API version, e.g. https://<host>:8888/api/v1 — the
# client appends /auth/tokens, /supplier/purchase-orders/... and so on.
IDEMPIERE_BASE_URL=
IDEMPIERE_USERNAME=
IDEMPIERE_PASSWORD=
IDEMPIERE_CLIENT_ID=
IDEMPIERE_ROLE_ID=
IDEMPIERE_ORG_ID=
IDEMPIERE_WAREHOUSE_ID=
IDEMPIERE_LANGUAGE=en_US
IDEMPIERE_SUPPLIER_CODE=

# ERP WRITES. Separate from the settings above on purpose.
#
# Filling in IDEMPIERE_* above only lets the portal READ purchase orders. This
# flag is what allows it to CREATE records: a bill submission
# (POST /supplier/bill-submission/add) and a supplier payment
# (POST /supplier/payment/add). Those are real documents in a shared ERP, and
# wanting to see live purchase orders is not the same as wanting to write to it.
#
# Must be exactly "true". Anything else, including unset, and both write routes
# answer 503 and nothing leaves the portal.
IDEMPIERE_WRITES_ENABLED=false

# The supplier-payment route ALSO requires BILLCHECK_INTERNAL above, and 404s
# without it. Recording a payment to a supplier is a treasury action, and every
# role in this portal is a supplier role picked from a menu.
