# Root ignore rules. Each sub-project keeps its OWN .gitignore (portal/.gitignore,
# agent/.gitignore) and those still apply inside their directories — a bare rule like
# `.env` in agent/.gitignore matches agent/.env, because gitignore patterns without a
# slash match at any depth below the file that declares them. The rules here are the
# repo-wide ones plus a belt-and-braces repeat of the two that must never fail.

# Secrets. Repeated from both sub-projects deliberately: a leaked key is not recoverable
# by editing .gitignore afterwards.
.env
.env.*
!.env.example
**/.env
**/.env.local

# Company-internal working papers and source tax documents. The YAML citations that
# reference these ARE committed; the documents themselves are not.
agent/application_example/
agent/nbr_documents/*.pdf
agent/nbr_documents/*.PDF

# The iDempiere Supplier API specification. It carries WORKING UAT CREDENTIALS
# (username + password), live JWT access and refresh tokens, and the internal host
# address. The integration built from it is committed; the document is not. The
# credentials belong in portal/.env.local, which is already ignored above.
Supplier_Portal_api_adding.pdf

# Local runtime data
agent/billcheck.db
agent/*.db
agent/outbox/
agent/audit_log/
# NOTE: agent/eval_reports/*.md is deliberately NOT ignored — those reports are
# deliverables that record how the agent scored, and are regenerated by
# `python -m app.cli eval`.

# Toolchain caches
node_modules/
.next/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.turbo/

# Editor / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
